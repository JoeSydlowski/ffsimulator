# personal league sim outputs stay local; keep the runner scripts
# league_sims/*
!league_sims/*.R

# simulation.rds outputs exceed GitHub's 100MB file limit
league_sims/**/simulation.rds

# FantasyCalc value-snapshot parquet accumulates locally
data/

# cached search sims (regenerable, ~20MB each) - the name encodes pos_filter and
# fill_missing_starters so a sim built for the wrong lineup can't be reused
league_sims/**/search_n*.rds
