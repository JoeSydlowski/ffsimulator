# personal league sim outputs stay local; keep the runner scripts
# league_sims/*
!league_sims/*.R

# simulation.rds outputs exceed GitHub's 100MB file limit
league_sims/**/simulation.rds

# FantasyCalc value-snapshot parquet accumulates locally
data/

# the watchlist page is regenerated weekly and published as an artifact
league_sims/waivers/**/*.html

# the playoff odds page is regenerated per run and published as an artifact
league_sims/playoff_odds/**/*.html
